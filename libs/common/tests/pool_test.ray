import pool;

@test
fn domain_refusals_keep_the_connection() {
    assert(pool.connection_ok("out_of_stock: product 1 has 0 left"));
    assert(pool.connection_ok("not_found: no product 9"));
    assert(pool.connection_ok("conflict: order o1 is not pending"));
    assert(!pool.connection_ok("unavailable: products database: broken pipe"));
    assert(!pool.connection_ok("ERROR 40001: deadlock"));
}

@test
fn only_reused_connections_that_broke_are_retried() {
    assert(pool.retry_on_fresh("Broken pipe (os error 32)", true));
    assert(!pool.retry_on_fresh("Broken pipe (os error 32)", false));
    assert(!pool.retry_on_fresh("out_of_stock: product 1 has 0 left", true));
    assert(!pool.retry_on_fresh("", true));
    let ok: Result<int, string> = Result.Ok(1);
    assert_eq(pool.error_of(ok), "");
    let bad: Result<int, string> = Result.Err("x");
    assert_eq(pool.error_of(bad), "x");
}

fn dial_seven() -> Result<int, string> {
    Result.Ok(7)
}

fn close_nothing(c: int) { }

@test
fn a_pool_dials_on_demand_and_reuses_what_comes_back() {
    let p: pool.Pool<int> = pool.new_pool(1);
    let first = pool.checkout(p, dial_seven).expect("dial");
    assert_eq(first.conn, 7);
    assert(!first.reused);
    pool.checkin(p, 42);
    let again = pool.checkout(p, dial_seven).expect("reuse");
    assert_eq(again.conn, 42);
    assert(again.reused);
    pool.discard(p);
    assert(!pool.checkout(p, dial_seven).expect("redial").reused);
}

@test
fn fibers_share_one_pool() {
    let p: pool.Pool<int> = pool.new_pool(2);
    let dials: Channel<int> = Channel.bounded(100);
    let done: Channel<int> = Channel.bounded(20);
    for i in 0..20 {
        spawn(fn() {
            let lease = pool.checkout(p, fn() -> Result<int, string> {
                send(dials, 1);
                Result.Ok(i)
            }).expect("checkout");
            pool.checkin(p, lease.conn);
            send(done, i);
        });
    }
    for _ in 0..20 {
        let _ = recv(done);
    }
    var n = 0;
    var going = true;
    while (going) {
        match (try_recv(dials)) {
            Received.Got(_) => {
                n = n + 1;
            },
            _ => {
                going = false;
            },
        }
    }
    assert(n <= 2);
}

@test
fn run_retries_a_stale_reused_connection_once_on_a_fresh_one() {
    let op = fn(c: int) -> Result<int, string> {
        if (c < 0) { Result.Err("broken pipe") } else { Result.Ok(c * 2) }
    };
    // -1 stands for a connection the server closed while it sat idle in the pool
    let p: pool.Pool<int> = pool.new_pool(1);
    let _ = pool.checkout(p, dial_seven);
    pool.checkin(p, -1);
    assert_eq(pool.run(p, true, dial_seven, close_nothing, op), Result.Ok(14));
    // without retry, the stale connection's error surfaces
    let q: pool.Pool<int> = pool.new_pool(1);
    let _ = pool.checkout(q, dial_seven);
    pool.checkin(q, -1);
    assert_eq(pool.run(q, false, dial_seven, close_nothing, op), Result.Err("broken pipe"));
    // a domain refusal is not retried
    let refuse = fn(c: int) -> Result<int, string> { Result.Err("out_of_stock: none left") };
    assert_eq(
        pool.run(p, true, dial_seven, close_nothing, refuse),
        Result.Err("out_of_stock: none left")
    );
}
