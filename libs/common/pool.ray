// Connection pools for the outbound adapters. Fibers do not share heaps, so a connection
// cached in an adapter value would be a per-request copy; a socket handle passed through a
// channel is the same socket in every fiber. A pool is therefore a bounded channel of slots —
// the shape of `rpc.pool` (packages/rpc), generic over the connection type:
//
//   checkout  recv a slot: Ready → use it; Empty → dial (a failed dial sends Empty back). A
//             fiber parks while every connection is in use: backpressure, not a busy-wait
//   checkin   send Ready(conn) back when the operation left the connection healthy
//   discard   the caller closed it after a wire failure: send Empty back, so that slot redials
//             next time and the pool heals after an outage
//   run       all of the above around one operation, plus the retry: a REUSED connection that
//             fails on the wire was most likely closed by the server while idle (a database
//             restart, an idle timeout), so the operation runs once more on a fresh connection
//             and a restart does not surface one error per pooled connection. Only for
//             idempotent operations; a fresh connection that fails is not retried.
//
// (Until raylang 1.27.14 generic code over `Channel<Slot<T>>` did not compile natively and each
// adapter carried its own copy — RAYLANG-FINDINGS #71.)

pub enum Slot<T> {
    Ready(T),
    Empty,
}

pub struct Pool<T> {
    slots: Channel<Slot<T>>,
}

/// A checked-out connection, and whether it was reused (it may have gone stale while idle).
pub struct Lease<T> {
    conn: T,
    reused: bool,
}

/// A pool of up to `size` connections (at least 1), all dialed on demand.
pub fn new_pool<T>(size: int) -> Pool<T> {
    let n = if (size < 1) { 1 } else { size };
    let slots: Channel<Slot<T>> = Channel.bounded(n);
    for _ in 0..n {
        let empty: Slot<T> = Slot.Empty;
        send(slots, empty);
    }
    Pool { slots: slots }
}

pub fn checkout<T>(p: Pool<T>, dial: fn() -> Result<T, string>) -> Result<Lease<T>, string> {
    match (recv(p.slots)) {
        Option.Some(Slot.Ready(c)) => Result.Ok(Lease { conn: c, reused: true }),
        Option.Some(Slot.Empty) => match (dial()) {
            Result.Ok(c) => Result.Ok(Lease { conn: c, reused: false }),
            Result.Err(e) => {
                discard(p);
                Result.Err(e)
            },
        },
        Option.None => Result.Err("unavailable: the pool is closed"),
    }
}

/// Gives a healthy connection back.
pub fn checkin<T>(p: Pool<T>, c: T) {
    send(p.slots, Slot.Ready(c));
}

/// Gives the slot back empty (its connection failed and the caller closed it).
pub fn discard<T>(p: Pool<T>) {
    let empty: Slot<T> = Slot.Empty;
    send(p.slots, empty);
}

/// After an operation that ended with `error` ("" = success): checkin, or close + discard.
pub fn give_back<T>(p: Pool<T>, c: T, error: string, close_conn: fn(T)) {
    if (error == "" || connection_ok(error)) {
        checkin(p, c);
    } else {
        close_conn(c);
        discard(p);
    }
}

/// Runs `op` on a pooled connection: back to the pool afterwards, unless the error came from
/// the wire (then `close_conn` and empty its slot). With `retry`, a reused connection that
/// failed on the wire is replaced and `op` runs once more.
pub fn run<T, R>(
    p: Pool<T>,
    retry: bool,
    dial: fn() -> Result<T, string>,
    close_conn: fn(T),
    op: fn(T) -> Result<R, string>
) -> Result<R, string> {
    let lease = checkout(p, dial)?;
    let out = op(lease.conn);
    let error = error_of(out);
    if (retry && retry_on_fresh(error, lease.reused)) {
        close_conn(lease.conn);
        return match (dial()) {
            Result.Ok(c) => {
                let again = op(c);
                give_back(p, c, error_of(again), close_conn);
                again
            },
            Result.Err(e) => {
                discard(p);
                Result.Err(e)
            },
        };
    }
    give_back(p, lease.conn, error, close_conn);
    out
}

/// Whether an operation's error leaves its connection usable: the domain's own refusals
/// ("out_of_stock: …", "not_found: …", "invalid: …", "conflict: …") come from the adapter's
/// logic, not from the wire; anything else may have left the connection out of sync.
pub fn connection_ok(error: string) -> bool {
    error.starts_with("out_of_stock:")
        || error.starts_with("not_found:")
        || error.starts_with("invalid:")
        || error.starts_with("conflict:")
}

/// The error of a result, or "" for a success.
pub fn error_of<T>(r: Result<T, string>) -> string {
    match (r) {
        Result.Ok(_) => "",
        Result.Err(e) => e,
    }
}

/// Whether an operation that failed with `error` on a connection should run once more on a
/// fresh one: the connection was reused (it may have gone stale while idle) and the failure
/// came from the wire, not from the domain.
pub fn retry_on_fresh(error: string, reused: bool) -> bool {
    reused && error != "" && !connection_ok(error)
}
