// A fake raymart.payment.v1.Payments server (proto/payment.proto) with an in-memory store:
// the interop target for real gRPC clients (grpcurl -plaintext) and the native-build check.
//
//   cd libs/grpc/examples/fake_payments && ray run main.ray 50051
//   grpcurl -plaintext -import-path proto -proto payment.proto \
//     -d '{"order_id":"o-1","amount_cents":1999,"currency":"EUR","card_last4":"4242","user_id":"ada"}' \
//     127.0.0.1:50051 raymart.payment.v1.Payments/CreateIntent
//
// `main.ray selftest` serves on an ephemeral port and drives it with grpc/client in the same
// process (exit 0 = every check passed): the native-binary check of client and server.
//
// Cards ending in 0002 are declined. The store lives in an actor fiber (connection fibers get
// copies of what they capture, so shared state must be reached through a channel).
import grpc/server;
import grpc/status;
import grpc/client;
import std/time;
import std/protobuf;
from grpc/server import Call, Router;
from grpc/status import Status;

const CREATE: string = "/raymart.payment.v1.Payments/CreateIntent";

const GET: string = "/raymart.payment.v1.Payments/GetIntent";

struct Intent {
    id: string,
    order_id: string,
    amount_cents: int,
    currency: string,
    status: string,
    reason: string,
    user_id: string,
}

// A request to the store actor: save `intent` (when `save`) or look up `id`.
struct Op {
    save: bool,
    id: string,
    intent: Intent,
    reply: Channel<Intent>,
}

fn empty_intent() -> Intent {
    Intent {
        id: "",
        order_id: "",
        amount_cents: 0,
        currency: "",
        status: "",
        reason: "",
        user_id: ""
    }
}

fn store(ops: Channel<Op>) {
    let intents: Map<string, Intent> = Map.new();
    while (true) {
        match (recv(ops)) {
            Option.Some(op) => {
                if (op.save) {
                    intents.insert(op.intent.id, op.intent);
                    send(op.reply, op.intent);
                } else {
                    send(op.reply, intents.get_or(op.id, empty_intent()));
                }
            },
            Option.None => return,
        }
    }
}

fn ask(ops: Channel<Op>, save: bool, id: string, intent: Intent) -> Intent {
    let reply: Channel<Intent> = Channel.new();
    send(ops, Op { save: save, id: id, intent: intent, reply: reply });
    recv(reply).unwrap_or(empty_intent())
}

fn encode_intent(i: Intent) -> bytes {
    let w = protobuf.writer();
    protobuf.write_string(w, 1, i.id);
    protobuf.write_string(w, 2, i.order_id);
    protobuf.write_varint(w, 3, i.amount_cents);
    protobuf.write_string(w, 4, i.currency);
    protobuf.write_string(w, 5, i.status);
    if (i.reason != "") {
        protobuf.write_string(w, 6, i.reason);
    }
    protobuf.write_string(w, 7, i.user_id);
    protobuf.finish(w)
}

fn create_intent(ops: Channel<Op>, c: Call) -> Result<bytes, Status> {
    let f = match (protobuf.parse(c.message)) {
        Result.Ok(x) => x,
        Result.Err(e) => return status.fail(status.INVALID_ARGUMENT, "bad CreateIntentRequest: ${e}"),
    };
    let order_id = protobuf.get_string(f, 1);
    let amount = protobuf.get_int(f, 2);
    if (order_id == "") {
        return status.fail(status.INVALID_ARGUMENT, "order_id is required");
    }
    if (amount <= 0) {
        return status.fail(status.INVALID_ARGUMENT, "amount_cents must be positive");
    }
    let declined = protobuf.get_string(f, 4) == "0002";
    let intent = Intent {
        id: "pi_" + order_id,
        order_id: order_id,
        amount_cents: amount,
        currency: protobuf.get_string(f, 3),
        status: if (declined) { "declined" } else { "succeeded" },
        reason: if (declined) { "card_declined" } else { "" },
        user_id: protobuf.get_string(f, 5)
    };
    Result.Ok(encode_intent(ask(ops, true, intent.id, intent)))
}

fn get_intent(ops: Channel<Op>, c: Call) -> Result<bytes, Status> {
    let f = match (protobuf.parse(c.message)) {
        Result.Ok(x) => x,
        Result.Err(e) => return status.fail(status.INVALID_ARGUMENT, "bad GetIntentRequest: ${e}"),
    };
    let id = protobuf.get_string(f, 1);
    let found = ask(ops, false, id, empty_intent());
    if (found.id == "") {
        return status.fail(status.NOT_FOUND, "no intent ${id}");
    }
    Result.Ok(encode_intent(found))
}

fn build(ops: Channel<Op>) -> Router {
    server
        .router()
        .route(CREATE, fn(c: Call) -> Result<bytes, Status> { create_intent(ops, c) })
        .route(GET, fn(c: Call) -> Result<bytes, Status> { get_intent(ops, c) })
        .route("/raymart.test.v1.Slow/Wait", fn(c: Call) -> Result<bytes, Status> {
        time.sleep(600);
        Result.Ok(b"")
    })
        .route("/raymart.test.v1.Echo/Echo", fn(c: Call) -> Result<bytes, Status> { Result.Ok(c.message) })
}

fn create_request(order_id: string, amount: int, last4: string) -> bytes {
    let w = protobuf.writer();
    protobuf.write_string(w, 1, order_id);
    protobuf.write_varint(w, 2, amount);
    protobuf.write_string(w, 3, "EUR");
    protobuf.write_string(w, 4, last4);
    protobuf.write_string(w, 5, "ada");
    protobuf.finish(w)
}

fn check(name: string, ok: bool, failures: [string]) {
    if (ok) {
        print("ok    ${name}");
    } else {
        print("FAIL  ${name}");
        failures.push(name);
    }
}

// The client side of `selftest`; returns the number of failed checks. `plain_port` serves a
// bare handler (serve_until) with 1 KiB messages.
fn selftest_client(port: int, plain_port: int) -> int {
    let failures: [string] = [];
    let md: Map<string, string> = Map.new();
    md.insert("traceparent", "00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01");
    let c = match (client.connect("127.0.0.1", port)) {
        Result.Ok(x) => x,
        Result.Err(e) => {
            print("FAIL  connect: ${e}");
            return 1;
        },
    };
    match (client.call(c, CREATE, create_request("o-1", 1999, "4242"), md, 2000)) {
        Result.Ok(r) => {
            let f = protobuf.parse(r.message).unwrap_or([]);
            check(
                "create intent",
                r.status == 0
                    && protobuf.get_string(f, 5) == "succeeded"
                    && protobuf.get_int(f, 3) == 1999,
                failures
            );
        },
        Result.Err(e) => check("create intent: ${e}", false, failures),
    }
    let w = protobuf.writer();
    protobuf.write_string(w, 1, "pi_o-1");
    match (client.call(c, GET, protobuf.finish(w), md, 2000)) {
        Result.Ok(r) => check(
            "get intent on the same connection",
            r.status == 0
                && protobuf.get_string(protobuf.parse(r.message).unwrap_or([]), 2) == "o-1",
            failures
        ),
        Result.Err(e) => check("get intent: ${e}", false, failures),
    }
    let w2 = protobuf.writer();
    protobuf.write_string(w2, 1, "pi_missing");
    match (client.call(c, GET, protobuf.finish(w2), md, 2000)) {
        Result.Ok(r) => check(
            "missing intent is NOT_FOUND",
            r.status == status.NOT_FOUND && r.status_message == "no intent pi_missing",
            failures
        ),
        Result.Err(e) => check("missing intent: ${e}", false, failures),
    }
    match (client.call(c, "/raymart.payment.v1.Payments/Refund", b"", md, 2000)) {
        Result.Ok(r) => check("unknown method is UNIMPLEMENTED", r.status == status.UNIMPLEMENTED, failures),
        Result.Err(e) => check("unknown method: ${e}", false, failures),
    }
    let big = "0123456789abcdef".repeat(20000).to_bytes();
    match (client.call(c, "/raymart.test.v1.Echo/Echo", big, md, 5000)) {
        Result.Ok(r) => check("320 KB echo crosses flow control", r.status == 0 && r.message == big, failures),
        Result.Err(e) => check("big echo: ${e}", false, failures),
    }
    let t0 = time.monotonic();
    match (client.call(c, "/raymart.test.v1.Slow/Wait", b"", md, 150)) {
        Result.Ok(r) => check(
            "deadline exceeded in time",
            r.status == status.DEADLINE_EXCEEDED && time.monotonic() - t0 < 500,
            failures
        ),
        Result.Err(e) => check("deadline: ${e}", false, failures),
    }
    match (client.call(c, "/raymart.test.v1.Echo/Echo", b"after", md, 3000)) {
        Result.Ok(r) => check(
            "connection usable after a cancelled stream",
            r.status == 0 && r.message == b"after",
            failures
        ),
        Result.Err(e) => check("after cancel: ${e}", false, failures),
    }
    client.disconnect(c);
    match (client.call_once(
        "127.0.0.1",
        port,
        CREATE,
        create_request("o-2", 500, "0002"),
        md,
        2000
    )) {
        Result.Ok(r) => check(
            "call_once, declined card",
            r.status == 0
                && protobuf.get_string(protobuf.parse(r.message).unwrap_or([]), 6) == "card_declined",
            failures
        ),
        Result.Err(e) => check("call_once: ${e}", false, failures),
    }
    match (client.connect("127.0.0.1", plain_port)) {
        Result.Ok(pc) => {
            match (client.call(pc, "/any.Service/Method", b"ping", md, 2000)) {
                Result.Ok(r) => check(
                    "bare handler sees the path",
                    r.status == 0 && r.message == b"/any.Service/Method:ping",
                    failures
                ),
                Result.Err(e) => check("bare handler: ${e}", false, failures),
            }
            match (client.call(
                pc,
                "/any.Service/Method",
                "x".repeat(200000).to_bytes(),
                md,
                3000
            )) {
                Result.Ok(r) => check(
                    "oversized request is RESOURCE_EXHAUSTED",
                    r.status == status.RESOURCE_EXHAUSTED,
                    failures
                ),
                Result.Err(e) => check("oversized: ${e}", false, failures),
            }
            match (client.call(pc, "/any.Service/Method", b"again", md, 2000)) {
                Result.Ok(r) => check("connection survives the oversized request", r.status == 0, failures),
                Result.Err(e) => check("after oversized: ${e}", false, failures),
            }
            client.disconnect(pc);
        },
        Result.Err(e) => check("connect plain: ${e}", false, failures),
    }
    failures.len()
}

fn main() -> int {
    let av = args();
    let selftest = av.len() > 0 && av[0] == "selftest";
    let port = if (av.len() > 0 && !selftest) { parse_int(av[0]).unwrap_or(50051) } else { 50051 };
    let ops: Channel<Op> = Channel.new();
    spawn(fn() {
        store(ops);
    });
    let l = match (server.bind(
        if (selftest) { "127.0.0.1" } else { "0.0.0.0" },
        if (selftest) { 0 } else { port }
    )) {
        Result.Ok(x) => x,
        Result.Err(e) => {
            eprint("bind: " + e);
            return 1;
        },
    };
    let stop: Channel<int> = if (selftest) { Channel.new() } else { signals() };
    let failed: Channel<int> = Channel.new();
    if (selftest) {
        let p = l.port;
        let plain = server.bind("127.0.0.1", 0).expect("bind");
        let pp = plain.port;
        spawn(fn() {
            let _ = server.serve_until(plain, stop, server.Options {
                max_message: 1024
            }, fn(c: Call) -> Result<bytes, Status> {
                Result.Ok(c.path.to_bytes() + b":" + c.message)
            });
        });
        spawn(fn() {
            send(failed, selftest_client(p, pp));
            close(stop);
        });
    } else {
        print("fake payments listening on port ${l.port}");
    }
    match (server.serve_router_until(l, stop, server.default_options(), fn() -> Router { build(ops) })) {
        Result.Ok(_) => { },
        Result.Err(e) => {
            eprint(e);
            return 1;
        },
    }
    if (selftest) {
        let n = recv(failed).unwrap_or(1);
        print(
            if (n == 0) { "selftest: all checks passed" } else { "selftest: ${n} check(s) failed" }
        );
        return if (n == 0) { 0 } else { 1 };
    }
    0
}
