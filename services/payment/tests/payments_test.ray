import std/json;
import common/events;
from domain/intent import Intent, PROCESSING, SUCCEEDED, FAILED;
from application/payments import Payments, new_payments, create_intent, get_intent, process_charge;
import adapters/outbound/memory;
import adapters/outbound/card_simulator;
import adapters/inbound/worker;

fn fixture() -> Payments<memory.MemoryIntents, card_simulator.CardSimulator, memory.MemoryBus> {
    new_payments(
        memory.new_memory_intents(),
        card_simulator.new_card_simulator(),
        memory.new_memory_bus()
    )
}

fn intent(
    p: Payments<memory.MemoryIntents, card_simulator.CardSimulator, memory.MemoryBus>,
    id: string,
    order: string,
    card: string
) -> Intent {
    match (create_intent(p, id, order, "ada", 1990, "USD", card, 1, "tp")) {
        Result.Ok(i) => i,
        Result.Err(e) => panic(e),
    }
}

fn status_of(r: Result<Intent, string>) -> string {
    match (r) {
        Result.Ok(i) => i.status,
        Result.Err(e) => e.split(":")[0],
    }
}

@test
fn an_intent_starts_processing_and_queues_its_charge() {
    let p = fixture();
    let i = intent(p, "pi_1", "o1", "4242");
    assert_eq(i.status, PROCESSING);
    assert_eq(p.bus.jobs.len(), 1);
    assert_eq(p.bus.jobs[0], "pi_1");
}

@test
fn one_intent_per_order() {
    let p = fixture();
    let a = intent(p, "pi_1", "o1", "4242");
    let b = intent(p, "pi_2", "o1", "4242");  // the relay retried
    assert_eq(b.id, a.id);
    assert_eq(p.repo.intents.len(), 1);
    assert_eq(p.bus.jobs.len(), 2);  // re-enqueued while processing; the worker is idempotent
}

@test
fn invalid_intents_are_refused() {
    let p = fixture();
    assert_eq(status_of(create_intent(p, "x", "o", "ada", 0, "USD", "4242", 1, "")), "invalid");
    assert_eq(
        status_of(create_intent(p, "x", "o", "ada", 10, "DOLLARS", "4242", 1, "")),
        "invalid"
    );
    assert_eq(status_of(create_intent(p, "x", "", "ada", 10, "USD", "4242", 1, "")), "invalid");
}

@test
fn charges_follow_the_test_cards() {
    let p = fixture();
    let _ = intent(p, "ok", "o1", "4242");
    let _ = intent(p, "no", "o2", "0002");
    let _ = intent(p, "poor", "o3", "0003");
    assert_eq(status_of(process_charge(p, "ok", "")), SUCCEEDED);
    assert_eq(status_of(process_charge(p, "no", "")), FAILED);
    assert_eq(match (get_intent(p, "poor")) {
        Result.Ok(i) => i.reason,
        Result.Err(_) => "",
    }, "");
    assert_eq(status_of(process_charge(p, "poor", "")), FAILED);
    assert_eq(match (get_intent(p, "poor")) {
        Result.Ok(i) => i.reason,
        Result.Err(_) => "",
    }, "insufficient funds");
    assert(p.bus.results.contains("payment.succeeded o1"));
    assert(p.bus.results.contains("payment.failed o2"));
}

@test
fn a_repeated_charge_republishes_without_charging_again() {
    let p = fixture();
    let _ = intent(p, "ok", "o1", "4242");
    let _ = process_charge(p, "ok", "");
    let _ = process_charge(p, "ok", "");
    assert_eq(p.bus.results.len(), 2);  // the result again, in case the first was lost
    assert_eq(status_of(get_intent(p, "ok")), SUCCEEDED);
}

@test
fn a_processor_error_leaves_the_intent_processing_for_a_retry() {
    let p = fixture();
    let _ = intent(p, "flaky", "o1", "0004");
    assert(process_charge(p, "flaky", "").is_err());
    assert_eq(status_of(get_intent(p, "flaky")), PROCESSING);
}

fn job(intent_id: string) -> string {
    let m: Map<string, json.Json> = Map.new();
    m.insert("intent_id", json.Json.JStr(intent_id));
    events.encode(events.new_event("payment.charge", "", json.Json.JObject(m)))
}

@test
fn the_worker_acks_nacks_and_drops() {
    let p = fixture();
    let _ = intent(p, "ok", "o1", "4242");
    let _ = intent(p, "flaky", "o2", "0004");
    assert(worker.handle_job(p, job("ok")));
    assert(!worker.handle_job(p, job("flaky")));  // nack: retried later
    assert(worker.handle_job(p, job("ghost")));  // unknown intent: dropped
    assert(worker.handle_job(p, "garbage"));
    p.bus.down[0] = true;
    assert(!worker.handle_job(p, job("ok")));  // could not publish: retry
}
