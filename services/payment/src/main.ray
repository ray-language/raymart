// payment — payment intents and charges. Composition root: MongoDB behind IntentRepository,
// the card simulator behind CardProcessor, rayq behind Bus. Inbound: gRPC (orders), HTTP
// (public read API) and the charge worker.
//
//   payment            serve (gRPC on GRPC_PORT, HTTP on HTTP_PORT, plus the worker)
//   payment health     exit 0 if this container's HTTP answers /health
import web/framework as web;
import rpc/rpc;
import net/http;
import grpc/server;
import common/config;
import common/logs;
from grpc/server import Router;
from application/payments import new_payments;
import adapters/outbound/mongo_intents;
import adapters/outbound/card_simulator;
import adapters/outbound/rayq_bus;
import adapters/inbound/http as http_in;
import adapters/inbound/grpc as grpc_in;
import adapters/inbound/worker;

fn health(port: int) -> int {
    match (http.fetch("http://127.0.0.1:${port}/health")) {
        Result.Ok(r) => if (r.status == 200) { 0 } else { 1 },
        Result.Err(_) => 1,
    }
}

fn main() -> int {
    let http_port = config.get_int("HTTP_PORT", 8080);
    let grpc_port = config.get_int("GRPC_PORT", 9100);
    let av = args();
    if (av.len() > 0 && av[0] == "health") {
        return health(http_port);
    }
    let secret = config.required("JWT_SECRET");
    let repo = mongo_intents.MongoIntents {
        host: config.get("MONGO_HOST", "127.0.0.1"),
        port: config.get_int("MONGO_PORT", 27017),
        user: config.get("MONGO_USER", "payments"),
        password: config.get("MONGO_PASSWORD", "payments"),
        database: config.get("MONGO_DATABASE", "payments"),
    };
    match (mongo_intents.migrate(repo, 60)) {
        Result.Ok(_) => logs.info("payment", "", "database ready", []),
        Result.Err(e) => {
            logs.error("payment", "", "database unavailable", [("error", e)]);
            return 1;
        },
    }
    let rayq_host = config.get("RAYQ_HOST", "127.0.0.1");
    let rayq_port = config.get_int("RAYQ_PORT", 7450);
    let payments = new_payments(repo, card_simulator.new_card_simulator(), rayq_bus.new_rayq_bus(rayq_host, rayq_port));
    let jobs = rpc.pool(rayq_host, rayq_port, 2);

    let _http = spawn(fn() {
        match (web.listen_graceful(fn() -> web.App { http_in.build(payments, secret) }, "0.0.0.0", http_port, 3000)) {
            Result.Err(e) => logs.error("payment", "", "http server stopped", [("error", e)]),
            Result.Ok(_) => { },
        }
    });
    let _worker = spawn(fn() { worker.work_forever(payments, jobs, 300); });
    let listener = match (server.bind("0.0.0.0", grpc_port)) {
        Result.Ok(l) => l,
        Result.Err(e) => {
            logs.error("payment", "", "cannot bind gRPC", [("error", e)]);
            return 1;
        },
    };
    logs.info("payment", "", "serving", [("grpc", to_string(grpc_port)), ("http", to_string(http_port))]);
    match (server.serve_router(listener, fn() -> Router { grpc_in.router(payments) })) {
        Result.Ok(_) => 0,
        Result.Err(e) => {
            logs.error("payment", "", "gRPC server stopped", [("error", e)]);
            1
        },
    }
}
