// The payment service's outbound ports.
import std/json;
from domain/intent import Intent, Charge;

pub trait IntentRepository {
    /// Stores the intent unless the order already has one; returns the one that is stored
    /// (idempotent per order id).
    fn create_if_absent(self, intent: Intent) -> Result<Intent, string>;
    fn find(self, id: string) -> Result<Option<Intent>, string>;
    /// Compare-and-set of the status (processing → succeeded/failed).
    fn finish(self, id: string, from: string, to: string, reason: string) -> Result<bool, string>;
}

pub trait CardProcessor {
    fn charge(self, intent: Intent) -> Result<Charge, string>;
}

/// The asynchronous side: charge jobs in, results out (both on rayq in production).
pub trait Bus {
    fn enqueue_charge(self, intent_id: string, traceparent: string) -> Result<int, string>;
    fn publish_result(self, kind: string, data: json.Json, traceparent: string) -> Result<int, string>;
}
