// The payment use cases, generic over the three ports.
//
// create_intent: validate → store (idempotent per order) → enqueue the charge. Answers at
//                once with the intent in `processing`; the charge happens in the worker.
// process_charge: the worker's step. A final intent only re-publishes its result (the
//                publish may have been lost before the job was acked), so the step is safe
//                to repeat under at-least-once delivery.
from domain/ports import IntentRepository, CardProcessor, Bus;
from domain/intent import
    Intent,
    new_intent,
    is_final,
    result_kind,
    result_data,
    PROCESSING,
    SUCCEEDED,
    FAILED;

pub struct Payments<R: IntentRepository, C: CardProcessor, B: Bus> {
    repo: R,
    cards: C,
    bus: B,
}

pub fn new_payments<R: IntentRepository, C: CardProcessor, B: Bus>(
    repo: R,
    cards: C,
    bus: B
) -> Payments<R, C, B> {
    Payments { repo: repo, cards: cards, bus: bus }
}

pub fn create_intent<R: IntentRepository, C: CardProcessor, B: Bus>(
    p: Payments<R, C, B>,
    id: string,
    order_id: string,
    user_id: string,
    amount_cents: int,
    currency: string,
    card_last4: string,
    now_ms: int,
    tp: string
) -> Result<Intent, string> {
    let fresh = new_intent(id, order_id, user_id, amount_cents, currency, card_last4, now_ms)?;
    let stored = p.repo.create_if_absent(fresh)?;
    if (stored.status == PROCESSING) {
        // Also on a repeated request: if the first enqueue was lost, this one is not.
        p.bus.enqueue_charge(stored.id, tp)?;
    }
    Result.Ok(stored)
}

pub fn get_intent<R: IntentRepository, C: CardProcessor, B: Bus>(
    p: Payments<R, C, B>,
    id: string
) -> Result<Intent, string> {
    match (p.repo.find(id)?) {
        Option.Some(i) => Result.Ok(i),
        Option.None => Result.Err("not_found: no payment ${id}"),
    }
}

pub fn process_charge<R: IntentRepository, C: CardProcessor, B: Bus>(
    p: Payments<R, C, B>,
    intent_id: string,
    tp: string
) -> Result<Intent, string> {
    let intent = get_intent(p, intent_id)?;
    if (is_final(intent)) {
        p.bus.publish_result(result_kind(intent), result_data(intent), tp)?;
        return Result.Ok(intent);
    }
    let charge = p.cards.charge(intent)?;
    let to = if (charge.approved) { SUCCEEDED } else { FAILED };
    p.repo.finish(intent.id, PROCESSING, to, charge.reason)?;
    let done = get_intent(p, intent_id)?;
    p.bus.publish_result(result_kind(done), result_data(done), tp)?;
    Result.Ok(done)
}
