import rpc/rpc;
import std/json;
from domain/cart import Cart, ProductInfo, total_cents, MAX_QTY;
from application/carts import
    Carts,
    new_carts,
    view,
    add_item,
    set_item_qty,
    remove_item,
    clear_cart;
import adapters/outbound/memory;
import adapters/inbound/rpc as rpc_in;

fn catalog() -> memory.FixedCatalog {
    memory.new_fixed_catalog(
        [
            ProductInfo { id: 1, name: "TR-808", price_cents: 129900, stock: 2 },
            ProductInfo { id: 5, name: "Cable", price_cents: 990, stock: 200 }
        ]
    )
}

fn carts() -> Carts<memory.MemoryCarts, memory.FixedCatalog> {
    new_carts(memory.new_memory_carts(), catalog())
}

fn err_code(r: Result<Cart, string>) -> string {
    match (r) {
        Result.Ok(_) => "ok",
        Result.Err(e) => e.split(":")[0],
    }
}

fn items(r: Result<Cart, string>) -> int {
    match (r) {
        Result.Ok(c) => c.items.len(),
        Result.Err(_) => -1,
    }
}

@test
fn adding_merges_lines_and_prices_from_the_catalog() {
    let c = carts();
    let _ = add_item(c, "ada", 5, 3, "");
    let r = add_item(c, "ada", 5, 2, "");
    match (r) {
        Result.Ok(cart) => {
            assert_eq(cart.items.len(), 1);
            assert_eq(cart.items[0].qty, 5);
            assert_eq(cart.items[0].price_cents, 990);
            assert_eq(total_cents(cart), 4950);
        },
        Result.Err(e) => panic(e),
    }
    assert_eq(items(view(c, "ada")), 1);
    assert_eq(items(view(c, "bob")), 0);  // carts are per user
}

@test
fn the_cart_refuses_what_the_catalog_cannot_give() {
    let c = carts();
    assert_eq(err_code(add_item(c, "ada", 1, 3, "")), "out_of_stock");
    assert_eq(err_code(add_item(c, "ada", 9, 1, "")), "not_found");
    assert_eq(err_code(add_item(c, "ada", 5, 0, "")), "invalid");
    assert_eq(err_code(set_item_qty(c, "ada", 5, MAX_QTY + 1, "")), "invalid");
    assert_eq(items(view(c, "ada")), 0);
}

@test
fn quantities_can_be_set_and_lines_removed() {
    let c = carts();
    let _ = add_item(c, "ada", 5, 1, "");
    let _ = add_item(c, "ada", 1, 1, "");
    assert_eq(match (set_item_qty(c, "ada", 5, 7, "")) {
        Result.Ok(x) => total_cents(x),
        Result.Err(_) => 0,
    }, 7 * 990 + 129900);
    assert_eq(items(set_item_qty(c, "ada", 5, 0, "")), 1);
    assert_eq(items(remove_item(c, "ada", 1)), 0);
    let _ = add_item(c, "ada", 5, 1, "");
    assert_eq(clear_cart(c, "ada").unwrap_or(-1), 1);
    assert_eq(items(view(c, "ada")), 0);
}

@test
fn the_trace_reaches_the_catalog() {
    let cat = catalog();
    let c = new_carts(memory.new_memory_carts(), cat);
    let tp = "00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01";
    let _ = add_item(c, "ada", 5, 1, tp);
    assert_eq(cat.seen.len(), 1);
    assert_eq(cat.seen[0], tp);  // the adapter (not the use case) makes the child span
}

fn call(
    c: Carts<memory.MemoryCarts, memory.FixedCatalog>,
    method: string,
    user: string
) -> Result<json.Json, string> {
    let m: Map<string, json.Json> = Map.new();
    m.insert("user_id", json.Json.JStr(user));
    rpc_in.handle(
        c,
        rpc.Req { method: method, params: json.Json.JObject(m), deadline_ms: 0, traceparent: "" }
    )
}

@test
fn orders_reads_and_clears_the_cart_over_rpc() {
    let c = carts();
    let _ = add_item(c, "ada", 5, 2, "");
    match (call(c, "cart.get", "ada")) {
        Result.Ok(j) => assert_eq(json.get_int(j, "total_cents").unwrap_or(0), 1980),
        Result.Err(e) => panic(e),
    }
    match (call(c, "cart.clear", "ada")) {
        Result.Ok(j) => assert(json.get_bool(j, "cleared").unwrap_or(false)),
        Result.Err(e) => panic(e),
    }
    assert_eq(items(view(c, "ada")), 0);
    assert(call(c, "cart.nope", "ada").is_err());
}
