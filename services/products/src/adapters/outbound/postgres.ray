// PostgreSQL ProductRepository over a `postgres.Pool` (db): an operation takes a pooled
// connection and gives it back — or drops it if the wire failed. A connection is used by one
// fiber at a time and survives the request, so the handshake (a backend process and a SCRAM
// exchange) is paid once per connection, not once per query, and closed sockets do not pile up
// in TIME_WAIT until the ephemeral ports run out (perf/README.md). Reservations run in one
// transaction with `SELECT … FOR UPDATE`, so two orders racing for the last unit cannot both win.
import db/postgres;
import net/pool;
import std/crypto;
import std/hex;
import std/time;
from domain/ports import ProductRepository;
from domain/product import Product, Line, Reserved;

pub struct PostgresProducts {
    db: postgres.Pool,
}

/// The repository with a pool of up to `pool_size` connections (dialed on demand).
pub fn new_products(
    host: string,
    port: int,
    user: string,
    password: string,
    database: string,
    pool_size: int
) -> PostgresProducts {
    PostgresProducts { db: postgres.pool(host, port, user, password, database, pool_size) }
}

fn nonce() -> string {
    hex.hex_encode(crypto.random_bytes(18))
}

fn open(r: PostgresProducts) -> Result<postgres.Conn, string> {
    let cfg = r.db.cfg;
    match (postgres.connect(cfg.host, cfg.port, cfg.user, cfg.password, cfg.database, nonce())) {
        Result.Ok(c) => Result.Ok(c),
        Result.Err(e) => Result.Err("unavailable: products database: " + e),
    }
}

// A server shutting down (a restart) or `pg_terminate_backend` ends each session with FATAL
// 57P01, which `pool.is_wire_error` does not take for a dead connection: the pool would keep
// it, and every pooled connection would fail one operation after a restart
// (RAYLANG-FINDINGS #95). Phrase it as the wire error it is.
fn wire(e: string) -> string {
    if (e.contains("terminating connection due to administrator command")) {
        return "the server closed the connection (" + e + ")";
    }
    e
}

/// Runs `op` on a pooled connection (net/pool). With `retry` (idempotent operations only), a
/// reused connection that fails on the wire is replaced and `op` runs once more. Transactions
/// go through here too: `postgres.pool_tx` never retries, not even when BEGIN fails on a
/// connection the server closed while idle (RAYLANG-FINDINGS #96).
fn with_conn<T>(
    r: PostgresProducts,
    retry: bool,
    op: fn(postgres.Conn) -> Result<T, string>
) -> Result<T, string> {
    pool.run(r.db.slots, fn() -> Result<postgres.Conn, string> { open(r) }, fn(c: postgres.Conn) {
        postgres.disconnect(c);
    }, fn(c: postgres.Conn) -> Result<T, string> { op(c).map_err(wire) }, retry)
}

fn to_int(s: string) -> int {
    parse_int(s).unwrap_or(0)
}

fn row_to_product(row: [string]) -> Product {
    Product {
        id: to_int(row[0]),
        sku: row[1],
        name: row[2],
        price_cents: to_int(row[3]),
        stock: to_int(row[4])
    }
}

/// Creates the schema if needed and seeds the catalog on an empty database. Retries while the
/// database is still starting (up to `attempts` seconds).
pub fn migrate(r: PostgresProducts, attempts: int) -> Result<int, string> {
    var last = "";
    for _ in 0..attempts {
        match (open(r)) {
            Result.Ok(c) => {
                let res = migrate_on(c);
                postgres.disconnect(c);
                return res;
            },
            Result.Err(e) => {
                last = e;
                time.sleep(1000);
            },
        }
    }
    Result.Err(last)
}

fn migrate_on(c: postgres.Conn) -> Result<int, string> {
    postgres.exec(c, `CREATE TABLE IF NOT EXISTS products (
        id SERIAL PRIMARY KEY,
        sku TEXT UNIQUE NOT NULL,
        name TEXT NOT NULL,
        price_cents INTEGER NOT NULL CHECK (price_cents >= 0),
        stock INTEGER NOT NULL CHECK (stock >= 0))`, [])?;
    postgres.exec(c, `CREATE TABLE IF NOT EXISTS reservations (
        order_id TEXT NOT NULL,
        product_id INTEGER NOT NULL REFERENCES products(id),
        name TEXT NOT NULL,
        price_cents INTEGER NOT NULL,
        qty INTEGER NOT NULL,
        status TEXT NOT NULL,
        PRIMARY KEY (order_id, product_id))`, [])?;
    let count = postgres.query(c, "SELECT count(*) FROM products", [])?;
    if (to_int(count[0][0]) == 0) {
        for p in seed() {
            postgres.exec(
                c,
                "INSERT INTO products (sku, name, price_cents, stock) VALUES ($1, $2, $3, $4)",
                [p.0, p.1, to_string(p.2), to_string(p.3)]
            )?;
        }
    }
    Result.Ok(0)
}

fn seed() -> [(string, string, int, int)] {
    [
        ("TR-808", "Rhythm Composer TR-808", 129900, 5),
        ("TB-303", "Bass Line TB-303", 89900, 8),
        ("SH-101", "Monophonic Synthesizer SH-101", 64900, 12),
        ("JUNO-60", "Polyphonic Synthesizer Juno-60", 159900, 3),
        ("CABLE-TRS", "TRS patch cable, 1 m", 990, 200),
        ("HEADPHONES", "Studio headphones", 12900, 40)
    ]
}

fn rollback(c: postgres.Conn, e: string) -> Result<[Reserved], string> {
    let _ = postgres.exec(c, "ROLLBACK", []);
    Result.Err(e)
}

fn reserve_on(c: postgres.Conn, order_id: string, lines: [Line]) -> Result<[Reserved], string> {
    postgres.exec(c, "BEGIN", [])?;
    let existing = postgres.query(
        c,
        "SELECT product_id, name, price_cents, qty FROM reservations WHERE order_id = $1 ORDER BY product_id",
        [order_id]
    )?;
    if (existing.len() > 0) {
        postgres.exec(c, "COMMIT", [])?;
        var out: [Reserved] = [];
        for row in existing {
            out.push(
                Reserved {
                    product_id: to_int(row[0]),
                    name: row[1],
                    price_cents: to_int(row[2]),
                    qty: to_int(row[3])
                }
            );
        }
        return Result.Ok(out);
    }
    var out: [Reserved] = [];
    for l in lines {
        let rows = match (postgres.query(
            c,
            "SELECT id, sku, name, price_cents, stock FROM products WHERE id = $1 FOR UPDATE",
            [to_string(l.product_id)]
        )) {
            Result.Ok(r) => r,
            Result.Err(e) => return rollback(c, e),
        };
        if (rows.len() == 0) {
            return rollback(c, "not_found: no product ${l.product_id}");
        }
        let p = row_to_product(rows[0]);
        if (p.stock < l.qty) {
            return rollback(c, "out_of_stock: product ${p.id} has ${p.stock} left");
        }
        match (postgres.exec(
            c,
            "UPDATE products SET stock = stock - $1 WHERE id = $2",
            [to_string(l.qty), to_string(p.id)]
        )) {
            Result.Ok(_) => { },
            Result.Err(e) => return rollback(c, e),
        }
        match (postgres.exec(
            c,
            "INSERT INTO reservations (order_id, product_id, name, price_cents, qty, status) VALUES ($1, $2, $3, $4, $5, 'reserved')",
            [order_id, to_string(p.id), p.name, to_string(p.price_cents), to_string(l.qty)]
        )) {
            Result.Ok(_) => { },
            Result.Err(e) => return rollback(c, e),
        }
        out.push(
            Reserved { product_id: p.id, name: p.name, price_cents: p.price_cents, qty: l.qty }
        );
    }
    postgres.exec(c, "COMMIT", [])?;
    Result.Ok(out)
}

fn release_on(c: postgres.Conn, order_id: string) -> Result<int, string> {
    postgres.exec(c, "BEGIN", [])?;
    let rows = postgres.query(
        c,
        "SELECT product_id, qty FROM reservations WHERE order_id = $1 AND status = 'reserved' FOR UPDATE",
        [order_id]
    )?;
    for row in rows {
        postgres.exec(c, "UPDATE products SET stock = stock + $1 WHERE id = $2", [row[1], row[0]])?;
    }
    postgres.exec(
        c,
        "UPDATE reservations SET status = 'released' WHERE order_id = $1 AND status = 'reserved'",
        [order_id]
    )?;
    postgres.exec(c, "COMMIT", [])?;
    Result.Ok(rows.len())
}

fn restock_on(c: postgres.Conn, id: int, qty: int) -> Result<Option<Product>, string> {
    let r = postgres.query(
        c,
        "UPDATE products SET stock = stock + $1 WHERE id = $2 RETURNING id, sku, name, price_cents, stock",
        [to_string(qty), to_string(id)]
    )?;
    if (r.len() == 0) {
        return Result.Ok(Option.None);
    }
    Result.Ok(Option.Some(row_to_product(r[0])))
}

fn find_on(c: postgres.Conn, id: int) -> Result<Option<Product>, string> {
    let r = postgres.query(
        c,
        "SELECT id, sku, name, price_cents, stock FROM products WHERE id = $1",
        [to_string(id)]
    )?;
    if (r.len() == 0) {
        return Result.Ok(Option.None);
    }
    Result.Ok(Option.Some(row_to_product(r[0])))
}

impl ProductRepository for PostgresProducts {
    fn list(self) -> Result<[Product], string> {
        with_conn(self, true, fn(c: postgres.Conn) -> Result<[Product], string> {
            Result.Ok(
                postgres.query(
                    c,
                    "SELECT id, sku, name, price_cents, stock FROM products ORDER BY id",
                    []
                )?.map(
                    row_to_product
                )
            )
        })
    }

    fn find(self, id: int) -> Result<Option<Product>, string> {
        with_conn(self, true, fn(c: postgres.Conn) -> Result<Option<Product>, string> { find_on(c, id) })
    }

    fn reserve(self, order_id: string, lines: [Line]) -> Result<[Reserved], string> {
        with_conn(self, true, fn(c: postgres.Conn) -> Result<[Reserved], string> { reserve_on(c, order_id, lines) })
    }

    fn commit(self, order_id: string) -> Result<int, string> {
        with_conn(self, true, fn(c: postgres.Conn) -> Result<int, string> {
            postgres.exec(
                c,
                "UPDATE reservations SET status = 'committed' WHERE order_id = $1 AND status = 'reserved'",
                [order_id]
            )
        })
    }

    fn release(self, order_id: string) -> Result<int, string> {
        with_conn(self, true, fn(c: postgres.Conn) -> Result<int, string> {
            let r = release_on(c, order_id);
            if (r.is_err()) {
                let _ = postgres.exec(c, "ROLLBACK", []);
            }
            r
        })
    }

    fn restock(self, id: int, qty: int) -> Result<Option<Product>, string> {
        with_conn(self, false, fn(c: postgres.Conn) -> Result<Option<Product>, string> { restock_on(c, id, qty) })
    }
}
