// The catalog's use cases, generic over the repository port: the same code runs against
// PostgreSQL in production and against memory in the tests.
from domain/ports import ProductRepository;
from domain/product import Product, Line, Reserved, validate_lines;

pub struct Catalog<R: ProductRepository> {
    repo: R,
}

pub fn new_catalog<R: ProductRepository>(repo: R) -> Catalog<R> {
    Catalog { repo: repo }
}

pub fn list_products<R: ProductRepository>(c: Catalog<R>) -> Result<[Product], string> {
    c.repo.list()
}

pub fn get_product<R: ProductRepository>(c: Catalog<R>, id: int) -> Result<Product, string> {
    match (c.repo.find(id)?) {
        Option.Some(p) => Result.Ok(p),
        Option.None => Result.Err("not_found: no product ${id}"),
    }
}

pub fn reserve_stock<R: ProductRepository>(c: Catalog<R>, order_id: string, lines: [Line]) -> Result<[Reserved], string> {
    if (order_id.trim().len() == 0) {
        return Result.Err("invalid: a reservation needs an order id");
    }
    validate_lines(lines)?;
    c.repo.reserve(order_id, lines)
}

pub fn commit_reservation<R: ProductRepository>(c: Catalog<R>, order_id: string) -> Result<int, string> {
    c.repo.commit(order_id)
}

pub fn release_reservation<R: ProductRepository>(c: Catalog<R>, order_id: string) -> Result<int, string> {
    c.repo.release(order_id)
}
