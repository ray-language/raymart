// Use cases and the rpc adapter over the in-memory repository: no database needed.
import rpc/rpc;
import std/json;
from domain/product import Product, Line, Reserved;
from application/catalog import Catalog, new_catalog, list_products, get_product, reserve_stock, commit_reservation, release_reservation;
import adapters/outbound/memory;
import adapters/inbound/rpc as rpc_in;

fn fixture() -> memory.MemoryProducts {
    memory.new_memory([
        Product { id: 1, sku: "TR-808", name: "TR-808", price_cents: 129900, stock: 2 },
        Product { id: 2, sku: "TB-303", name: "TB-303", price_cents: 89900, stock: 5 },
    ])
}

fn stock_of(repo: memory.MemoryProducts, id: int) -> int {
    match (get_product(new_catalog(repo), id)) { Result.Ok(p) => p.stock, Result.Err(_) => -1 }
}

fn code(r: Result<[Reserved], string>) -> string {
    match (r) {
        Result.Ok(_) => "ok",
        Result.Err(e) => e.split(":")[0],
    }
}

@test
fn lists_and_finds_products() {
    let c = new_catalog(fixture());
    assert_eq(list_products(c).unwrap_or([]).len(), 2);
    assert_eq(match (get_product(c, 2)) { Result.Ok(p) => p.sku, Result.Err(_) => "" }, "TB-303");
    match (get_product(c, 9)) {
        Result.Err(e) => assert(e.starts_with("not_found")),
        Result.Ok(_) => panic("found a missing product"),
    }
}

@test
fn a_reservation_takes_stock_and_keeps_the_price() {
    let repo = fixture();
    let c = new_catalog(repo);
    let r = reserve_stock(c, "o1", [Line { product_id: 1, qty: 2 }, Line { product_id: 2, qty: 1 }]);
    match (r) {
        Result.Ok(items) => {
            assert_eq(items.len(), 2);
            assert_eq(items[0].price_cents, 129900);
        },
        Result.Err(e) => panic(e),
    }
    assert_eq(stock_of(repo, 1), 0);
    assert_eq(stock_of(repo, 2), 4);
}

@test
fn a_reservation_is_all_or_nothing() {
    let repo = fixture();
    let c = new_catalog(repo);
    let r = reserve_stock(c, "o1", [Line { product_id: 2, qty: 1 }, Line { product_id: 1, qty: 3 }]);
    assert_eq(code(r), "out_of_stock");
    assert_eq(stock_of(repo, 2), 5); // the first line was not taken either
}

@test
fn reserving_the_same_order_twice_takes_stock_once() {
    let repo = fixture();
    let c = new_catalog(repo);
    let _ = reserve_stock(c, "o1", [Line { product_id: 2, qty: 2 }]);
    let again = reserve_stock(c, "o1", [Line { product_id: 2, qty: 2 }]);
    assert_eq(code(again), "ok");
    assert_eq(stock_of(repo, 2), 3);
}

@test
fn release_returns_stock_once_and_never_after_commit() {
    let repo = fixture();
    let c = new_catalog(repo);
    let _ = reserve_stock(c, "cancelled", [Line { product_id: 2, qty: 2 }]);
    assert_eq(release_reservation(c, "cancelled").unwrap_or(-1), 1);
    assert_eq(release_reservation(c, "cancelled").unwrap_or(-1), 0);
    assert_eq(stock_of(repo, 2), 5);

    let _ = reserve_stock(c, "paid", [Line { product_id: 2, qty: 1 }]);
    assert_eq(commit_reservation(c, "paid").unwrap_or(-1), 1);
    assert_eq(release_reservation(c, "paid").unwrap_or(-1), 0);
    assert_eq(stock_of(repo, 2), 4);
}

@test
fn invalid_reservations_are_refused() {
    let c = new_catalog(fixture());
    assert_eq(code(reserve_stock(c, "o", [])), "invalid");
    assert_eq(code(reserve_stock(c, "o", [Line { product_id: 1, qty: 0 }])), "invalid");
    assert_eq(code(reserve_stock(c, "o", [Line { product_id: 1, qty: 1 }, Line { product_id: 1, qty: 1 }])), "invalid");
    assert_eq(code(reserve_stock(c, " ", [Line { product_id: 1, qty: 1 }])), "invalid");
    assert_eq(code(reserve_stock(c, "o", [Line { product_id: 99, qty: 1 }])), "not_found");
}

fn call(c: Catalog<memory.MemoryProducts>, method: string, params: string) -> Result<json.Json, string> {
    let p = match (json.parse(params)) {
        Result.Ok(j) => j,
        Result.Err(e) => panic(e),
    };
    rpc_in.handle(c, rpc.Req { method: method, params: p, deadline_ms: 0, traceparent: "" })
}

@test
fn the_rpc_adapter_speaks_the_catalog() {
    let c = new_catalog(fixture());
    match (call(c, "products.reserve", `{"order_id":"o9","lines":[{"product_id":2,"qty":2}]}`)) {
        Result.Ok(j) => {
            let items = json.get_array(j, "items").unwrap_or([]);
            assert_eq(items.len(), 1);
            assert_eq(json.get_int(items[0], "price_cents").unwrap_or(0), 89900);
        },
        Result.Err(e) => panic(e),
    }
    match (call(c, "products.get", `{"id":2}`)) {
        Result.Ok(j) => assert_eq(json.get_int(j, "stock").unwrap_or(-1), 3),
        Result.Err(e) => panic(e),
    }
    match (call(c, "products.reserve", `{"order_id":"o10","lines":[{"product_id":1,"qty":5}]}`)) {
        Result.Err(e) => assert(e.starts_with("out_of_stock")),
        Result.Ok(_) => panic("reserved more than the stock"),
    }
    assert(call(c, "products.nope", `{}`).is_err());
}
