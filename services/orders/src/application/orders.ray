// The orders use cases — the checkout saga — generic over the four ports.
//
// checkout:  cart lines → reserve stock (catalog prices) → order + outbox message in one
//            transaction → clear the cart. If the order cannot be stored, the reservation is
//            released (compensation).
// relay:     the outbox is delivered to the payment service (at least once; the payment
//            side is idempotent per order), so a payment request survives any crash.
// result:    a payment outcome commits (paid) or releases (cancelled) the stock, then moves
//            the order. Stock first: a retry after a failure redoes an idempotent step.
import std/json;
from domain/ports import OrderRepository, CartGateway, Inventory, Payments;
from domain/order import
    Order,
    PaymentResult,
    OutboxEntry,
    new_order,
    valid_card_last4,
    payment_request,
    PENDING,
    PAID,
    CANCELLED;

pub const PAYMENT_REQUESTED: string = "payment.requested";

pub struct Orders<R: OrderRepository, C: CartGateway, I: Inventory, P: Payments> {
    repo: R,
    cart: C,
    inventory: I,
    payments: P,
}

pub fn new_orders<R: OrderRepository, C: CartGateway, I: Inventory, P: Payments>(
    repo: R,
    cart: C,
    inventory: I,
    payments: P
) -> Orders<R, C, I, P> {
    Orders { repo: repo, cart: cart, inventory: inventory, payments: payments }
}

pub fn checkout<R: OrderRepository, C: CartGateway, I: Inventory, P: Payments>(
    o: Orders<R, C, I, P>,
    user: string,
    card_last4: string,
    order_id: string,
    now_ms: int,
    tp: string
) -> Result<Order, string> {
    if (!valid_card_last4(card_last4)) {
        return Result.Err("invalid: card_last4 must be 4 digits");
    }
    let lines = o.cart.lines(user, tp)?;
    if (lines.len() == 0) {
        return Result.Err("invalid: the cart is empty");
    }
    let items = o.inventory.reserve(order_id, lines, tp)?;
    let order = new_order(order_id, user, items, now_ms)?;
    match (o.repo.create(order, PAYMENT_REQUESTED, payment_request(order, card_last4, tp))) {
        Result.Ok(_) => { },
        Result.Err(e) => {
            // Compensate: the stock goes back; the error is what the caller sees.
            let _ = o.inventory.release(order_id, tp);
            return Result.Err(e);
        },
    }
    // The order exists; an uncleared cart is only an inconvenience, never a failure.
    let _ = o.cart.clear(user, tp);
    Result.Ok(order)
}

pub fn get_order<R: OrderRepository, C: CartGateway, I: Inventory, P: Payments>(
    o: Orders<R, C, I, P>,
    user: string,
    id: string
) -> Result<Order, string> {
    match (o.repo.find(id)?) {
        // Someone else's order does not exist, as far as this user is concerned.
        Option.Some(order) => if (order.user_id == user) {
            Result.Ok(order)
        } else {
            Result.Err("not_found: no order ${id}")
        },
        Option.None => Result.Err("not_found: no order ${id}"),
    }
}

pub fn list_orders<R: OrderRepository, C: CartGateway, I: Inventory, P: Payments>(
    o: Orders<R, C, I, P>,
    user: string
) -> Result<[Order], string> {
    o.repo.list_for(user)
}

/// Delivers up to `limit` outbox messages, in order. A transient failure (the payment
/// service unavailable) stops the pass — the rest are retried next time, in order. A permanent
/// rejection (invalid / not_found) must not block the queue forever: the message is set aside
/// and its order is failed like a declined payment (stock released, order cancelled).
/// Returns how many messages were handled.
pub fn relay_outbox<R: OrderRepository, C: CartGateway, I: Inventory, P: Payments>(
    o: Orders<R, C, I, P>,
    limit: int
) -> Result<int, string> {
    var handled = 0;
    for entry in o.repo.pending_outbox(limit)? {
        let tp = match (json.parse(entry.payload)) {
            Result.Ok(j) => json.get_string(j, "traceparent").unwrap_or(""),
            Result.Err(_) => "",
        };
        match (o.payments.create_intent(entry.payload, tp)) {
            Result.Ok(_) => { },
            Result.Err(e) => {
                if (!is_permanent(e)) {
                    return Result.Err(e);
                }
                let rejected = PaymentResult {
                    order_id: entry.order_id,
                    payment_id: "",
                    succeeded: false,
                    reason: "payment request rejected: " + e
                };
                apply_payment_result(o, rejected, tp)?;
            },
        }
        o.repo.mark_sent(entry.id)?;
        handled = handled + 1;
    }
    Result.Ok(handled)
}

/// Errors that retrying cannot fix.
pub fn is_permanent(e: string) -> bool {
    e.starts_with("invalid:") || e.starts_with("not_found:")
}

/// Applies a payment outcome. Idempotent: an order that already left pending_payment is left
/// as it is ("duplicate"), an unknown order is ignored.
pub fn apply_payment_result<R: OrderRepository, C: CartGateway, I: Inventory, P: Payments>(
    o: Orders<R, C, I, P>,
    r: PaymentResult,
    tp: string
) -> Result<string, string> {
    let order = match (o.repo.find(r.order_id)?) {
        Option.Some(x) => x,
        Option.None => return Result.Ok("ignored"),
    };
    if (order.status != PENDING) {
        return Result.Ok("duplicate");
    }
    if (r.succeeded) {
        o.inventory.commit(order.id, tp)?;
        o.repo.transition(order.id, PENDING, PAID, r.payment_id, "")?;
        return Result.Ok(PAID);
    }
    o.inventory.release(order.id, tp)?;
    o.repo.transition(order.id, PENDING, CANCELLED, r.payment_id, r.reason)?;
    Result.Ok(CANCELLED)
}
