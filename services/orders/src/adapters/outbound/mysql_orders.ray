// OrderRepository on MySQL over a pool of connections (common/pool.ray): each operation checks
// a connection out and gives it back — or closes it if the wire failed. The order, its items
// and its outbox message are written in ONE transaction.
import db/mysql;
import common/pool;
import std/time;
from domain/ports import OrderRepository;
from domain/order import Order, OrderItem, OutboxEntry;

pub struct MysqlOrders {
    host: string,
    port: int,
    user: string,
    password: string,
    database: string,
    conns: pool.Pool<mysql.Conn>,
}

/// The repository with a pool of up to `pool_size` connections (dialed on demand).
pub fn new_orders(
    host: string,
    port: int,
    user: string,
    password: string,
    database: string,
    pool_size: int
) -> MysqlOrders {
    MysqlOrders {
        host: host,
        port: port,
        user: user,
        password: password,
        database: database,
        conns: pool.new_pool(pool_size)
    }
}

fn open(r: MysqlOrders) -> Result<mysql.Conn, string> {
    match (mysql.connect(r.host, r.port, r.user, r.password, r.database)) {
        Result.Ok(c) => Result.Ok(c),
        Result.Err(e) => Result.Err("unavailable: orders database: " + e),
    }
}

fn close_conn(c: mysql.Conn) {
    mysql.disconnect(c);
}

/// Runs `op` on a pooled connection. With `retry` (idempotent operations only), a reused
/// connection that fails on the wire is replaced and `op` runs once more (common/pool.ray).
fn with_conn<T>(
    r: MysqlOrders,
    retry: bool,
    op: fn(mysql.Conn) -> Result<T, string>
) -> Result<T, string> {
    pool.run(r.conns, retry, fn() -> Result<mysql.Conn, string> { open(r) }, close_conn, op)
}

// The order, its items and its outbox message in one transaction. Err("begin: …") when the
// transaction could not even start: nothing was written, so a retry is safe.
fn create_tx(
    c: mysql.Conn,
    order: Order,
    outbox_kind: string,
    outbox_payload: string
) -> Result<int, string> {
    match (mysql.exec(c, "START TRANSACTION", [])) {
        Result.Ok(_) => { },
        Result.Err(e) => return Result.Err("begin: " + e),
    }
    match (create_on(c, order, outbox_kind, outbox_payload)) {
        Result.Ok(n) => match (mysql.exec(c, "COMMIT", [])) {
            Result.Ok(_) => Result.Ok(n),
            Result.Err(e) => Result.Err(e),
        },
        Result.Err(e) => {
            let _ = mysql.exec(c, "ROLLBACK", []);
            Result.Err(e)
        },
    }
}

fn to_int(s: string) -> int {
    parse_int(s).unwrap_or(0)
}

/// Creates the schema, retrying while MySQL is still starting (up to `attempts` seconds).
pub fn migrate(r: MysqlOrders, attempts: int) -> Result<int, string> {
    var last = "";
    for _ in 0..attempts {
        match (open(r)) {
            Result.Ok(c) => {
                let res = migrate_on(c);
                mysql.disconnect(c);
                return res;
            },
            Result.Err(e) => {
                last = e;
                time.sleep(1000);
            },
        }
    }
    Result.Err(last)
}

fn migrate_on(c: mysql.Conn) -> Result<int, string> {
    mysql.exec(c, `CREATE TABLE IF NOT EXISTS orders (
        id VARCHAR(40) PRIMARY KEY,
        user_id VARCHAR(120) NOT NULL,
        status VARCHAR(30) NOT NULL,
        total_cents BIGINT NOT NULL,
        created_ms BIGINT NOT NULL,
        payment_id VARCHAR(60) NOT NULL DEFAULT '',
        reason VARCHAR(200) NOT NULL DEFAULT '',
        INDEX by_user (user_id, created_ms))`, [])?;
    mysql.exec(c, `CREATE TABLE IF NOT EXISTS order_items (
        order_id VARCHAR(40) NOT NULL,
        product_id INT NOT NULL,
        name VARCHAR(200) NOT NULL,
        price_cents BIGINT NOT NULL,
        qty INT NOT NULL,
        PRIMARY KEY (order_id, product_id))`, [])?;
    mysql.exec(c, `CREATE TABLE IF NOT EXISTS outbox (
        id BIGINT AUTO_INCREMENT PRIMARY KEY,
        order_id VARCHAR(40) NOT NULL,
        kind VARCHAR(60) NOT NULL,
        payload TEXT NOT NULL,
        created_ms BIGINT NOT NULL,
        sent_ms BIGINT NULL,
        INDEX pending (sent_ms, id))`, [])?;
    Result.Ok(0)
}

fn create_on(c: mysql.Conn, o: Order, kind: string, payload: string) -> Result<int, string> {
    mysql.exec(
        c,
        "INSERT INTO orders (id, user_id, status, total_cents, created_ms) VALUES (?, ?, ?, ?, ?)",
        [o.id, o.user_id, o.status, to_string(o.total_cents), to_string(o.created_ms)]
    )?;
    for it in o.items {
        mysql.exec(
            c,
            "INSERT INTO order_items (order_id, product_id, name, price_cents, qty) VALUES (?, ?, ?, ?, ?)",
            [o.id, to_string(it.product_id), it.name, to_string(it.price_cents), to_string(it.qty)]
        )?;
    }
    mysql.exec(
        c,
        "INSERT INTO outbox (order_id, kind, payload, created_ms) VALUES (?, ?, ?, ?)",
        [o.id, kind, payload, to_string(o.created_ms)]
    )?;
    Result.Ok(1)
}

fn items_of(c: mysql.Conn, order_id: string) -> Result<[OrderItem], string> {
    let rows = mysql.query(
        c,
        "SELECT product_id, name, price_cents, qty FROM order_items WHERE order_id = ? ORDER BY product_id",
        [order_id]
    )?;
    var out: [OrderItem] = [];
    for row in rows {
        out.push(
            OrderItem {
                product_id: to_int(row[0]),
                name: row[1],
                price_cents: to_int(row[2]),
                qty: to_int(row[3])
            }
        );
    }
    Result.Ok(out)
}

fn order_of(c: mysql.Conn, row: [string]) -> Result<Order, string> {
    Result.Ok(
        Order {
            id: row[0],
            user_id: row[1],
            status: row[2],
            items: items_of(c, row[0])?,
            total_cents: to_int(row[3]),
            created_ms: to_int(row[4]),
            payment_id: row[5],
            reason: row[6]
        }
    )
}

const COLUMNS: string = "id, user_id, status, total_cents, created_ms, payment_id, reason";

fn find_on(c: mysql.Conn, id: string) -> Result<Option<Order>, string> {
    let rows = mysql.query(c, "SELECT ${COLUMNS} FROM orders WHERE id = ?", [id])?;
    if (rows.len() == 0) {
        return Result.Ok(Option.None);
    }
    Result.Ok(Option.Some(order_of(c, rows[0])?))
}

fn list_on(c: mysql.Conn, user: string) -> Result<[Order], string> {
    var out: [Order] = [];
    for row in mysql.query(
        c,
        "SELECT ${COLUMNS} FROM orders WHERE user_id = ? ORDER BY created_ms DESC LIMIT 50",
        [user]
    )? {
        out.push(order_of(c, row)?);
    }
    Result.Ok(out)
}

fn outbox_on(c: mysql.Conn, limit: int) -> Result<[OutboxEntry], string> {
    var out: [OutboxEntry] = [];
    for row in mysql.query(
        c,
        "SELECT id, order_id, kind, payload FROM outbox WHERE sent_ms IS NULL ORDER BY id LIMIT ${limit}",
        []
    )? {
        out.push(
            OutboxEntry { id: to_int(row[0]), order_id: row[1], kind: row[2], payload: row[3] }
        );
    }
    Result.Ok(out)
}

impl OrderRepository for MysqlOrders {
    fn create(self, order: Order, outbox_kind: string, outbox_payload: string) -> Result<int, string> {
        // Not idempotent (a lost COMMIT acknowledgement must not become a second attempt), so a
        // stale connection is only replaced when the transaction could not even begin.
        let lease = pool.checkout(self.conns, fn() -> Result<mysql.Conn, string> { open(self) })?;
        let out = create_tx(lease.conn, order, outbox_kind, outbox_payload);
        let error = pool.error_of(out);
        if (lease.reused && error.starts_with("begin: ")) {
            close_conn(lease.conn);
            return match (open(self)) {
                Result.Ok(c) => {
                    let again = create_tx(c, order, outbox_kind, outbox_payload);
                    pool.give_back(self.conns, c, pool.error_of(again), close_conn);
                    again
                },
                Result.Err(e) => {
                    pool.discard(self.conns);
                    Result.Err(e)
                },
            };
        }
        pool.give_back(self.conns, lease.conn, error, close_conn);
        out
    }

    fn find(self, id: string) -> Result<Option<Order>, string> {
        with_conn(self, true, fn(c: mysql.Conn) -> Result<Option<Order>, string> { find_on(c, id) })
    }

    fn list_for(self, user_id: string) -> Result<[Order], string> {
        with_conn(self, true, fn(c: mysql.Conn) -> Result<[Order], string> { list_on(c, user_id) })
    }

    fn transition(
        self,
        id: string,
        from: string,
        to: string,
        payment_id: string,
        reason: string
    ) -> Result<bool, string> {
        // A compare-and-set: running it twice cannot move the order twice.
        let n = with_conn(self, true, fn(c: mysql.Conn) -> Result<int, string> {
            mysql.exec(
                c,
                "UPDATE orders SET status = ?, payment_id = ?, reason = ? WHERE id = ? AND status = ?",
                [to, payment_id, reason, id, from]
            )
        })?;
        Result.Ok(n == 1)
    }

    fn pending_outbox(self, limit: int) -> Result<[OutboxEntry], string> {
        with_conn(self, true, fn(c: mysql.Conn) -> Result<[OutboxEntry], string> { outbox_on(c, limit) })
    }

    fn mark_sent(self, outbox_id: int) -> Result<int, string> {
        with_conn(self, true, fn(c: mysql.Conn) -> Result<int, string> {
            mysql.exec(
                c,
                "UPDATE outbox SET sent_ms = ? WHERE id = ?",
                [to_string(time.now()), to_string(outbox_id)]
            )
        })
    }
}
